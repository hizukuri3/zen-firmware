#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // Tap for J, hold to reach the scroll layer while the thumb stays on the
        // ball. require-prior-idle-ms keeps the hold from firing mid-word.
        scroll_j: scroll_j {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Tap for space, hold to reach the arrow layer under the right thumb.
        // require-prior-idle-ms keeps the hold from firing on the space that
        // ends a word.
        nav_space: nav_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        // Pick the host and its modifier layout in one press. ZMK cannot detect
        // the OS, so the profile key carries the layer switch with it.
        to_mac: to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };

        to_win: to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
            layers = <0 1 2 3 4 5 6>;
            require-prior-idle-ms = <100>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <20 21>;
            layers = <0 1 2 3 4 5 6>;
            require-prior-idle-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE &kp Q       &kp W             &kp E     &kp R             &kp T  &kp Y         &kp U      &kp I  &kp O           &kp P           &kp BSPC
&mo 5      &kp A       &kp S             &kp D     &kp F             &kp G  &kp H         &scroll_j 4 J  &kp K      &kp L           &kp MINUS       &kp SEMI
&mo 3      &kp Z       &kp X             &kp C     &kp V             &kp B  &kp TAB       &kp LG(LS(N4))  &kp N  &kp M           &kp COMMA       &kp DOT          &kp SLASH     &kp ENTER
&mo 2      &kp GRAVE   &kp LEFT_CONTROL  &kp LALT  &kp LSHFT         &kp LEFT_GUI  &mo 2  &nav_space 7 SPACE  &kp RGUI  &kp SQT         &kp EQUAL       &mo 3
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans     &trans  &trans  &trans      &trans      &trans  &trans  &trans           &trans  &trans  &trans
&trans  &trans     &trans  &trans  &trans      &trans      &trans  &scroll_j 6 J  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans  &trans      &trans      &trans  &kp LG(LS(S))  &trans           &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LGUI   &trans  &trans      &kp LCTRL   &trans  &trans  &kp RCTRL        &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2  &kp N3    &kp N4      &kp N5     &kp N6     &kp N7         &kp N8     &kp N9                &kp N0                 &kp DELETE
&trans      &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BSLH
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &trans     &trans                &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&out OUT_USB  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &trans          &kp N7  &kp N8  &kp N9   &kp ASTRK  &trans
&out OUT_BLE  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &trans          &kp N4  &kp N5  &kp N6   &kp MINUS  &kp PLUS
&trans        &kp F11       &kp F12       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL  &trans  &trans  &kp N1   &kp N2     &kp N3     &kp SLASH  &trans
&to_mac       &to_win       &trans        &trans        &trans        &trans        &trans          &trans  &kp N0  &kp DOT  &trans     &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &kp LC(UP_ARROW)     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans               &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans               &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &kp LG(TAB)              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans                   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans                   &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp LEFT_BRACE        &trans                 &trans          &kp RIGHT_BRACE &trans           &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                &trans                 &trans          &trans          &trans           &trans  &trans
            >;
        };
    };
};
