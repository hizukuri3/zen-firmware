#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Windows is driven with a JIS (106/109) host layout, so the same HID code
 * prints a different symbol there than it does on the Mac. The Windows profile
 * gets its own copy of every layer whose symbols depend on the host: layer 7
 * mirrors layer 6, and layer 9 mirrors layer 8. Layer 2 is shared, because its
 * number pad uses keypad codes that mean the same thing under either layout.
 *
 * The unshifted half is a plain substitution:
 *
 *   want  Mac (US)   Win (JIS)      want  Mac (US)  Win (JIS)
 *   ----  ---------  ---------      ----  --------  ---------
 *    @    LS(N2)     LBKT            [    LBKT      RBKT
 *    ^    LS(N6)     EQUAL           ]    RBKT      BSLH
 *    &    LS(N7)     LS(N6)          {    LS(LBKT)  LS(RBKT)
 *    *    LS(N8)     LS(SQT)         }    LS(RBKT)  LS(BSLH)
 *    (    LS(N9)     LS(N8)          \    BSLH      INT1
 *    )    LS(N0)     LS(N9)          _    LS(MINUS) LS(INT1)
 *    '    SQT        LS(N7)          |    LS(BSLH)  LS(INT3)
 *    =    EQUAL      LS(MINUS)       ~    LS(GRAVE) LS(EQUAL)
 *    +    LS(SEMI)   LS(SEMI)        `    GRAVE     LS(LBKT)
 *    :    LS(SEMI)   SQT             "    LS(SQT)   LS(N2)
 *
 * The shifted half cannot be, because JIS pairs the two halves of a key
 * differently: Shift+"-" is "=" on JIS but "_" on US, Shift+";" is "+" on JIS
 * but ":" on US. Every key whose pair differs is therefore a mod-morph, so that
 * adding Shift produces what a US keyboard would produce. Where the JIS spelling
 * of the shifted symbol is itself a shifted code the Shift stays on the report
 * (keep-mods); where it is an unshifted code the Shift is masked off.
 *
 * Note also that on JIS the bare GRAVE code is the 半角/全角 key, not a
 * backtick, so the Windows profile reaches the backtick through LS(LBKT).
 */

/ {
    behaviors {
        // Tap for K, hold to reach the scroll layer while the thumb stays on the
        // ball. require-prior-idle-ms keeps the hold from firing mid-word.
        scroll_k: scroll_k {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Tap for space, hold to reach the arrow layer under the right thumb.
        // require-prior-idle-ms keeps the hold from firing on the space that
        // ends a word.
        nav_space: nav_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // Space on the Mac profile. With Ctrl or Cmd already down the press is a
        // shortcut, never a layer hold, so skip the hold-tap and send the space
        // straight away. keep-mods leaves the modifier on the report so the host
        // still sees Ctrl+Space / Cmd+Space.
        mac_space: mac_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&nav_space 6 SPACE>, <&kp SPACE>;
            mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>;
        };

        // Space on the Windows profile. Same rule as mac_space, holding the JIS
        // copy of the arrow layer instead.
        win_space: win_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&nav_space 7 SPACE>, <&kp SPACE>;
            mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>;
        };

        // ---- JIS shift pairs, base layer ----

        jis_minus: jis_minus {  // - / _
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp INT1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_semi: jis_semi {  // ; / :   colon is an unshifted code on JIS
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_grave: jis_grave {  // ` / ~
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT)>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_sqt: jis_sqt {  // ' / "
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_equal: jis_equal {  // = / +
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ---- JIS shift pairs, symbol layer ----

        jis_bslh: jis_bslh {  // \ / |
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT1>, <&kp INT3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // On US these two are already shifted codes, so Shift does nothing to
        // them. On JIS they are unshifted, so the Shift has to be masked off.
        jis_at: jis_at {  // @ / @
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_caret: jis_caret {  // ^ / ^
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ---- JIS shift pairs, symbol layer digit row ----

        jis_2: jis_2 {  // 2 / @
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_6: jis_6 {  // 6 / ^
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_7: jis_7 {  // 7 / &
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp N6>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_8: jis_8 {  // 8 / *
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp SQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_9: jis_9 {  // 9 / (
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp N8>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_colon: jis_colon {  // : / :   bare SQT is ':' on JIS, so mask Shift
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp SQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        jis_0: jis_0 {  // 0 / )
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp N9>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // Pick the host and its modifier layout in one press. ZMK cannot detect
        // the OS, so the profile key carries the layer switch with it.
        //
        // src/profile_layers.c makes the same move on its own whenever the
        // active profile changes, including after the deep sleep that resets
        // the layer state, so the base layer can never drift away from the
        // profile. The &to here is still worth keeping: selecting the profile
        // that is already active raises no event, which makes these keys the
        // way to force the two back into step by hand.
        to_mac: to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };

        to_win: to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <4>;
        };

        // The number pad is left out of both click combos on purpose: positions
        // 19-21 carry its 4, 5 and 6, so "45" or "56" typed inside the combo
        // window would send a click instead of the digits. The two Cmd layers
        // are out for the same reason, where those positions spell & and *.
        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
            layers = <0 1 3 4 5>;
            require-prior-idle-ms = <100>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <20 21>;
            layers = <0 1 3 4 5>;
            require-prior-idle-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE &kp Q       &kp W             &kp E     &kp R             &kp T  &kp Y         &kp U      &kp I  &kp O           &kp P           &kp BSPC
&kp TAB    &kp A       &kp S             &kp D     &kp F             &kp G  &kp H         &kp J      &scroll_k 3 K  &kp L           &kp MINUS       &kp SEMI
&kp LSHFT  &kp Z       &kp X             &kp C     &kp V             &kp B  &kp BSLH      &kp LG(LS(N4))  &kp N  &kp M           &kp COMMA       &kp DOT          &kp SLASH     &kp ENTER
&mo 4      &kp GRAVE   &kp LEFT_CONTROL  &kp LALT  &kp LSHFT         &mo 8  &mo 2         &mac_space  &kp RGUI  &kp SQT         &kp EQUAL       &mo 2
            >;
        };

        // Windows profile. Modifiers move to their Windows positions, the base
        // layer symbols whose JIS spelling differs become mod-morphs so Shift
        // still produces the US pair, and the symbol/arrow layer keys point at
        // the JIS copies. The number pad is shared, so its &mo 2 stays.
        layer_1 {
            bindings = <
&trans  &trans      &trans    &trans  &trans  &trans     &trans  &trans          &trans         &trans  &trans      &trans
&trans  &trans      &trans    &trans  &trans  &trans     &trans  &trans          &scroll_k 5 K  &trans  &jis_minus  &jis_semi
&trans  &trans      &trans    &trans  &trans  &trans     &jis_bslh  &kp LG(LS(S))   &trans         &trans  &trans      &trans  &trans  &trans
&trans  &jis_grave  &kp LGUI  &trans  &trans  &mo 9      &trans  &win_space      &kp RCTRL      &jis_sqt  &jis_equal  &trans
            >;
        };

        // Shared by both profiles. The number pad uses keypad codes, which carry
        // their own meaning regardless of the host layout, so there is no JIS
        // copy of this layer.
        //
        // Two ways in, one per hand, because the layer serves two halves. The
        // number pad is all right-hand, so it is held from the left thumb; the
        // F-keys are all left-hand, so they are held from the right by the
        // mo at the end of the bottom row.
        layer_2 {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS     &kp KP_PLUS
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans  &trans     &trans     &kp KP_N1  &kp KP_N2        &kp KP_N3  &kp KP_DIVIDE  &trans
&trans  &trans   &trans   &trans  &trans  &trans   &trans  &trans     &kp KP_N0  &kp KP_DOT  &trans          &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LEFT_ARROW)  &trans  &kp LC(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &kp LC(UP_ARROW)     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans               &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans               &trans  &trans
            >;
        };

        // Radio layer, held on the bottom left. Every key here sits at a
        // position the number pad leaves alone: the two are on the same pinky
        // column, so overshooting one opens the other, and landing on nothing
        // beats landing on a profile switch.
        // Profiles run in order along the bottom row, starting next to the mo.
        layer_4 {
            bindings = <
&trans  &trans   &trans   &trans        &trans        &trans        &out OUT_USB    &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans        &trans        &trans        &out OUT_BLE    &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans        &trans        &trans        &trans          &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &to_mac  &to_win  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LC(LEFT_ARROW))  &trans  &kp LG(LC(RIGHT_ARROW))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &kp LG(TAB)              &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans                   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans                   &trans  &trans
            >;
        };

        // Arrows, symbols, and the low half of the digits, held with the right
        // thumb on space.
        //
        // The left hand reads down a US digit row: 1 to 5 on Q to T, and their
        // shifted halves ! @ # $ % directly underneath. Held on the right and
        // typed on the left, so neither hand has to hold and reach at once.
        // 6 to 0 with ^ & * beneath them are the mirror of this on layer 8,
        // held on the left and typed on the right.
        //
        // Below those the openers run { [ ( inward along C, V and B. Their
        // closers sit at the mirrored positions on layer 8 - N, M and the
        // comma - so a pair is always one hand each: ( from the left, ) from
        // the right, and neither hand ever holds and reaches.
        //
        // Stopping the digits at 5 is what keeps the right half of this layer
        // intact. Ten of them would have run through the Y column, which is ],
        // and the I column, which is up. Only [ gave way on the T column, and
        // it comes back on the V column below.
        layer_6 {
            bindings = <
&trans  &kp N1     &kp N2  &kp N3    &kp N4      &kp N5                &kp RIGHT_BRACKET      &trans          &kp UP_ARROW     &trans             &trans          &kp DELETE
&trans  &kp EXCL   &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT             &kp RIGHT_PARENTHESIS  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW    &kp UNDERSCORE  &kp COLON
&trans  &trans     &trans  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &trans  &trans          &kp RIGHT_BRACE  &trans             &kp LESS_THAN   &kp GREATER_THAN  &kp QUESTION  &trans
&trans  &kp TILDE  &trans  &trans  &trans  &trans                &trans                 &trans          &trans           &kp DOUBLE_QUOTES  &kp PLUS        &trans
            >;
        };

        // JIS copy of layer 6. Arrows and the unshifted digit codes are
        // host-independent, so both carry over unchanged; the brackets are not.
        layer_7 {
            bindings = <
&trans  &kp N1         &kp N2   &kp N3      &kp N4      &kp N5        &kp BSLH    &trans          &kp UP_ARROW    &trans           &trans         &kp DELETE
&trans  &kp LS(N1)     &jis_at  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)    &kp LS(N9)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LS(INT1)   &jis_colon
&trans  &trans         &trans  &kp LS(RBKT)  &kp RBKT  &kp LS(N8)  &trans      &trans          &kp LS(BSLH)    &trans           &kp LS(COMMA)  &kp LS(DOT)   &kp LS(SLASH)  &trans
&trans  &kp LS(EQUAL)  &trans  &trans  &trans  &trans        &trans      &trans          &trans          &kp LS(N2)       &kp LS(SEMI)   &trans
            >;
        };

        // The Cmd layer, held on the left thumb where LGUI used to sit.
        //
        // Two jobs in one hold. The right hand carries the half of the symbol
        // layout the space layer does not: 6 to 0 on Y to P, ^ & * beneath
        // them, and the closers ) ] } on N, M and the comma - each one at the
        // mirror of its opener on layer 6, so a bracket pair is one hand each.
        // Everything else on the board answers as LG(itself), so holding this
        // key and typing C still sends Cmd+C and the thumb keeps the job it
        // had.
        //
        // Six shortcuts gave up their keys to those symbols: Cmd with H, J, K,
        // N, M and the comma. Cmd with 1 to 5 is not here either - the left
        // hand's top row is Cmd+Q through Cmd+T and there is no room - but
        // those are rare enough on this board to leave out.
        //
        // Space is the reason this shape is needed at all. Cmd+Space switches
        // the input method, and it used to work because mac_space sees Cmd
        // already down and sends a plain space instead of taking the hold.
        // With LGUI gone from the thumb that no longer fires, so the space
        // position spells the shortcut out: LG(SPACE), with no hold-tap in the
        // way.
        //
        // Where the fall-through is deliberate: the modifiers stay live so
        // Cmd+Shift+key still composes, the layer keys stay reachable, and
        // RGUI on the bottom row is a real held Cmd for the three things a
        // re-pressed one cannot do - cycling Cmd+Tab, Cmd+click, Cmd+drag.
        //
        // The Windows profile runs the same shape one layer down, on layer 9,
        // with LCTRL in place of LGUI and the symbols spelled the JIS way.
        layer_8 {
            bindings = <
&trans  &kp LG(Q)      &kp LG(W)  &kp LG(E)  &kp LG(R)  &kp LG(T)  &kp N6       &kp N7         &kp N8     &kp N9         &kp N0         &kp LG(BSPC)
&trans  &kp LG(A)      &kp LG(S)  &kp LG(D)  &kp LG(F)  &kp LG(G)  &kp CARET    &kp AMPERSAND  &kp ASTRK  &kp LG(L)      &kp LG(MINUS)  &kp LG(SEMI)
&trans  &kp LG(Z)      &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &kp LG(TAB)  &trans         &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp LG(DOT)  &kp LG(SLASH)  &kp LG(ENTER)
&trans  &kp LG(GRAVE)  &trans     &trans     &trans     &trans     &trans       &kp LG(SPACE)  &trans     &kp LG(SQT)    &kp LG(EQUAL)  &trans
            >;
        };

        // The Ctrl layer, the Windows twin of layer 8, held where LCTRL used to
        // sit on the left thumb. Same shape, same reason: the letters answer as
        // LC(themselves) so Ctrl+C still works from that thumb, the right hand
        // types 6 to 0, and Ctrl+Space keeps the input switch.
        //
        // The digits and the letters carry over from layer 8 unchanged, since
        // neither depends on the host layout. The symbols do not: ^ & * and
        // ) ] } are spelled the JIS way here, per the table at the top of this
        // file. The three Mac-only shortcuts drop out - Cmd+` cycles windows,
        // and Cmd+' and Cmd+= have no Windows reading - and on JIS the bare
        // GRAVE code is 半角/全角 rather than a backtick, so that key falls
        // through rather than sending a modified one.
        layer_9 {
            bindings = <
&trans  &kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)  &kp N6       &kp N7       &kp N8       &kp N9        &kp N0         &kp LC(BSPC)
&trans  &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)  &kp EQUAL    &kp LS(N6)   &kp LS(SQT)  &kp LC(L)     &kp LC(MINUS)  &kp LC(SEMI)
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &kp LC(TAB)  &trans       &kp LS(N9)   &kp BSLH      &kp LS(BSLH)   &kp LC(DOT)  &kp LC(SLASH)  &kp LC(ENTER)
&trans  &trans     &trans     &trans     &trans     &trans     &trans       &kp LC(SPACE)  &trans     &trans        &trans         &trans
            >;
        };
    };
};
